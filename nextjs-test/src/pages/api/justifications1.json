ides&amp;m=nat-basic&amp;s=sslash\" data-ftml-notationid=\"\"><mrow data-ftml-arg=\"1\" data-ftml-argmode=\"i\"><mrow data-ftml-term=\"OMA\" data-ftml-head=\"http://mathhub.info?a=courses/Jacobs/GenCS/course&amp;p=dmath/slides&amp;m=nat-basic&amp;s=sslash\" data-ftml-notationid=\"\"><mrow data-ftml-arg=\"1\" data-ftml-argmode=\"i\"><mrow data-ftml-term=\"OMID\" data-ftml-head=\"http://mathhub.info?a=courses/Jacobs/GenCS/course&amp;p=dmath/slides&amp;m=nat-basic&amp;s=szero\" data-ftml-notationid=\"\"><mrow data-ftml-comp=\"\">\n\t\t\t\n\t\t\t<mspace class=\"rustex-mkern\" width=\"0.27778em\"></mspace></mrow></mrow></mrow><mrow data-ftml-comp=\"\"><mi class=\"rustex-math-ord\">∕</mi></mrow></mrow></mrow><mrow data-ftml-comp=\"\"><mi class=\"rustex-math-ord\">∕</mi></mrow></mrow></mrow><mrow data-ftml-comp=\"\"><mi class=\"rustex-math-ord\">∕</mi></mrow></mrow>\n\t\t\t<mo lspace=\"0\" rspace=\"0\" class=\"rustex-math-rel\" stretchy=\"false\">=</mo>\n\t\t\t<mrow data-ftml-term=\"OMA\" data-ftml-head=\"http://mathhub.info?a=courses/Jacobs/GenCS/course&amp;p=dmath/slides&amp;m=nat-basic&amp;s=sslash\" data-ftml-notationid=\"\" data-ftml-id=\"term_2\"><mrow data-ftml-arg=\"1\" data-ftml-argmode=\"i\"><mrow data-ftml-term=\"OMA\" data-ftml-head=\"http://mathhub.info?a=courses/Jacobs/GenCS/course&amp;p=dmath/slides&amp;m=nat-basic&amp;s=sslash\" data-ftml-notationid=\"\"><mrow data-ftml-arg=\"1\" data-ftml-argmode=\"i\"><mrow data-ftml-term=\"OMID\" data-ftml-head=\"http://mathhub.info?a=courses/Jacobs/GenCS/course&amp;p=dmath/slides&amp;m=nat-basic&amp;s=szero\" data-ftml-notationid=\"\"><mrow data-ftml-comp=\"\">\n\t\t\t\n\t\t\t<mspace class=\"rustex-mkern\" width=\"0.27778em\"></mspace></mrow></mrow></mrow><mrow data-ftml-comp=\"\"><mi class=\"rustex-math-ord\">∕</mi></mrow></mrow></mrow><mrow data-ftml-comp=\"\"><mi class=\"rustex-math-ord\">∕</mi></mrow></mrow>\n\t\t</mrow></math>, i.e. <math class=\"rustex-math\" data-rustex-sourceref=\"./courses/FAU/SMAI/problems/sou